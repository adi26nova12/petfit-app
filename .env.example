# Copy to .env.local and fill in. Expo exposes EXPO_PUBLIC_* to the app at build time.

# PetFit API base URL (same API the web app reads).
EXPO_PUBLIC_API_URL=https://api.petfit.co.in/api/v1

# true  = run on the bundled demo data in src/data/mock.ts (default)
# false = call the real API through src/api/index.ts
EXPO_PUBLIC_USE_MOCKS=true
